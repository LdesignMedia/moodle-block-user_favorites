# --- Project Configuration ---
PROJECT_NAME=user_favorites-405-7841
PLUGIN_TYPE=local
PLUGIN_NAME=moodle-block-user_favorites
PLUGIN_PATH=${MOODLE_ROOT_DIR:-/var/www/html}/local/moodle-block-user_favorites

# --- Plugin Dependencies ---
# List required plugin dependencies with their local paths (semicolon-separated)
# Format: plugin_type_name:/local/path/to/plugin;another_type_name:/another/local/path
# Example: local_moodleoverflow:/Users/john/plugins/moodleoverflow;mod_hvp:/Users/john/plugins/hvp
# These plugins will be mounted into Moodle before your plugin is installed
PLUGIN_DEPENDENCIES=

# --- Moodle Configuration ---
MOODLE_VERSION=405
MOODLE_URL=https://localhost:8445
MOODLE_ROOT_DIR=/var/www/html
MOODLE_DATA_DIR=/var/www/moodledata
MOODLE_FULLNAME="Moodle 4.5"
MOODLE_SHORTNAME=moodle
MOODLE_SUMMARY="Development Moodle Site"
MOODLE_LANG=en
MOODLE_PREFIX=mdl_
MOODLE_REVERSE_PROXY=false
MOODLE_SSLPROXY=true

# --- Moodle Admin Configuration ---
MOODLE_ADMINUSER=admin
MOODLE_ADMINPASS=moodle
MOODLE_ADMINEMAIL=admin@example.com
# Legacy names for compatibility
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=moodle
MOODLE_ADMIN_EMAIL=admin@example.com

# --- Database Configuration ---
MOODLE_DB_HOST=user_favorites-405-7841-db
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=secret
MOODLE_DB_TYPE=mysqli
MOODLE_DB_PORT=3306

# --- MySQL Configuration ---
MYSQL_ROOT_PASSWORD=moodle
MYSQL_DATABASE=moodle
MYSQL_USER=moodle
MYSQL_PASSWORD=secret

# --- Port Configuration ---
MOODLE_HTTP_PORT=8082
MOODLE_HTTPS_PORT=8445
MYSQL_PORT=3310
PHPMYADMIN_PORT=8082
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- SMTP Configuration ---
SMTP_HOST=user_favorites-405-7841-mailhog
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# --- Development/Debug Configuration ---
MOODLE_DEBUG=32767
MOODLE_DEBUGDISPLAY=1
MOODLE_DEBUGSMTP=true
MOODLE_PERFDEBUG=15
MOODLE_DEBUG_EMAIL=debug@localhost.localhost
MOODLE_PHP_VERSION=/usr/bin/php
MOODLE_SERVICES_ENABLE=1
